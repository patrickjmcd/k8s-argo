    {
      "type": "table",
      "title": "Range summary",
      "description": "Per-room min/mean/max over the selected time range (hourly rollup).",
      "datasource": {
        "type": "postgres",
        "uid": "ha-timescale"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ha-timescale"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT e.label AS \"Room\",\n  min(h.min) * CASE WHEN e.unit = '°C' THEN 1.8 ELSE 1 END + CASE WHEN e.unit = '°C' THEN 32 ELSE 0 END AS \"Min\",\n  sum(h.avg * h.samples) / sum(h.samples) * CASE WHEN e.unit = '°C' THEN 1.8 ELSE 1 END + CASE WHEN e.unit = '°C' THEN 32 ELSE 0 END AS \"Mean\",\n  max(h.max) * CASE WHEN e.unit = '°C' THEN 1.8 ELSE 1 END + CASE WHEN e.unit = '°C' THEN 32 ELSE 0 END AS \"Max\"\nFROM ltss_hourly h JOIN ha_entities e USING (entity_id)\nWHERE h.entity_id IN (${rooms:sqlstring}) AND $__timeFilter(h.bucket)\nGROUP BY e.label, e.unit ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Min"
            },
            "properties": [
