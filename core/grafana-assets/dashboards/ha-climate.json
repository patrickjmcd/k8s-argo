    {
      "type": "stat",
      "title": "Rooms now",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "ha-timescale"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ha-timescale"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT now() AS \"time\", e.label AS metric, ha_num(e.state) * CASE WHEN e.unit = '°C' THEN 1.8 ELSE 1 END + CASE WHEN e.unit = '°C' THEN 32 ELSE 0 END AS value\nFROM ha_entities e WHERE e.entity_id IN (${rooms:sqlstring}) AND ha_num(e.state) IS NOT NULL\nORDER BY 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 62
              },
              {
                "color": "orange",
                "value": 76
              },
              {
                "color": "red",
                "value": 82
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
