{
  "uid": "ha-climate",
  "title": "Home Assistant — Climate",
  "description": "Room temperatures and humidity, cold storage and equipment temperatures.",
  "tags": [
    "home-assistant"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
