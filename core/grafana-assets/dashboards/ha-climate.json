  "templating": {
    "list": [
      {
        "type": "query",
        "name": "rooms",
        "label": "Rooms",
        "datasource": {
          "type": "postgres",
          "uid": "ha-timescale"
        },
        "query": "SELECT e.label AS __text, e.entity_id AS __value FROM ha_entities e WHERE e.domain = 'sensor' AND e.device_class = 'temperature' AND e.entity_id !~ '(device_temperature|printer|mcdata|fordpass|freezer|fridge|refrigerator|lumi_lumi|target|apparent|cloud_aqi|outdoor|^sensor\\.home_|filament|dehumidifier)' ORDER BY 1",
        "definition": "SELECT e.label AS __text, e.entity_id AS __value FROM ha_entities e WHERE e.domain = 'sensor' AND e.device_class = 'temperature' AND e.entity_id !~ '(device_temperature|printer|mcdata|fordpass|freezer|fridge|refrigerator|lumi_lumi|target|apparent|cloud_aqi|outdoor|^sensor\\.home_|filament|dehumidifier)' ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "sort": 0,
        "hide": 0,
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "type": "query",
        "name": "humidity",
        "label": "Humidity sensors",
        "datasource": {
          "type": "postgres",
          "uid": "ha-timescale"
        },
        "query": "SELECT e.label AS __text, e.entity_id AS __value FROM ha_entities e WHERE e.domain = 'sensor' AND e.device_class = 'humidity' AND e.entity_id !~ '(printer|freezer|fridge|lumi_lumi|cloud_aqi|outdoor|^sensor\\.home_|filament|humidifier_humidity)' ORDER BY 1",
        "definition": "SELECT e.label AS __text, e.entity_id AS __value FROM ha_entities e WHERE e.domain = 'sensor' AND e.device_class = 'humidity' AND e.entity_id !~ '(printer|freezer|fridge|lumi_lumi|cloud_aqi|outdoor|^sensor\\.home_|filament|humidifier_humidity)' ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "sort": 0,
        "hide": 0,
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
