  "editable": true,
  "description": "Visitor stats for joshhawleygop.com from nginx JSON access logs in Loki (5-year per-stream retention, see core/loki.yaml).",
  "panels": [
    {
      "type": "stat",
      "title": "Page views",
      "id": 1,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({namespace=\"default\", container=\"joshhawleygop\"} |= `\"log\":\"access\"` | json | method=\"GET\" | status=\"200\" | uri=~`/(index\\.html)?(\\?.*)?` | ua!~`(?i).*(bot|crawl|spider|slurp|preview|curl|wget|python|go-http|headless|scan|monitor).*` [$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "Successful GETs of the page by browsers, bots excluded, over the selected time range.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
