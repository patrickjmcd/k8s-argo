          "rawSql": "SELECT l.time AS \"Time\", e.label AS \"Sensor\",\n  CASE WHEN e.device_class IN ('door','window','opening','garage_door')\n       THEN CASE l.state WHEN 'on' THEN 'Opened' ELSE 'Closed' END\n       WHEN e.device_class IN ('motion','occupancy','presence')\n       THEN CASE l.state WHEN 'on' THEN 'Motion' ELSE 'Clear' END\n       ELSE CASE l.state WHEN 'on' THEN 'ALARM' ELSE 'Clear' END END AS \"Event\"\nFROM ltss l JOIN ha_entities e USING (entity_id)\nWHERE ((e.domain = 'binary_sensor' AND e.device_class IN ('door', 'window', 'opening', 'garage_door')) OR (e.domain = 'binary_sensor' AND e.device_class IN ('motion', 'occupancy', 'presence') AND e.entity_id <> 'binary_sensor.frigate_activity') OR (e.domain = 'binary_sensor' AND e.device_class IN ('smoke', 'carbon_monoxide', 'gas', 'moisture', 'safety', 'heat') AND e.entity_id !~ 'rain')) AND l.state = 'on'\n  AND l.time > now() - INTERVAL '24 hours'\nORDER BY l.time DESC LIMIT 25"
        }
      ],
