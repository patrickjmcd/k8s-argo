          "rawSql": "SELECT e.label AS \"Sensor\", initcap(e.device_class) AS \"Type\", e.last_seen AS \"Since\"\nFROM ha_entities e WHERE ((e.domain = 'binary_sensor' AND e.device_class IN ('door', 'window', 'opening', 'garage_door')) OR (e.domain = 'binary_sensor' AND e.device_class IN ('smoke', 'carbon_monoxide', 'gas', 'moisture', 'safety', 'heat') AND e.entity_id !~ 'rain')) AND e.state = 'on' ORDER BY 3 DESC"
