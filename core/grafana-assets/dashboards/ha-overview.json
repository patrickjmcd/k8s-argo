          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT s.ts AS \"time\", e.label AS metric, CASE WHEN e.unit = '°C' THEN s.value * 9 / 5 + 32 ELSE s.value END AS value\nFROM ha_series(ARRAY['sensor.outdoor_temperature', 'sensor.home_apparent_temperature'], $__timeFrom(), $__timeTo(), make_interval(secs => $__interval_ms / 1000.0)) s\nJOIN ha_entities e USING (entity_id)\nORDER BY 1"
        },
