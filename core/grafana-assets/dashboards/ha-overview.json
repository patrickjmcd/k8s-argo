          "datasource": {
            "type": "postgres",
            "uid": "ha-timescale"
          },
          "refId": "B",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT s.ts AS \"time\", avg(s.value) AS \"Indoor (avg)\"\nFROM ha_series(ARRAY(SELECT e.entity_id FROM ha_entities e WHERE e.domain = 'sensor' AND e.device_class = 'temperature' AND e.entity_id !~ '(device_temperature|printer|mcdata|fordpass|freezer|fridge|refrigerator|lumi_lumi|target|apparent|cloud_aqi|outdoor|^sensor\\.home_|filament|dehumidifier)'), $__timeFrom(), $__timeTo(), make_interval(secs => $__interval_ms / 1000.0)) s\nGROUP BY 1 ORDER BY 1"
        }
