{
  "uid": "recyclarr",
  "title": "Recyclarr",
  "tags": [
    "media",
    "recyclarr"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Server",
      "description": "Whether Prometheus can scrape the Recyclarr server (media/recyclarr, management port 7983).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(up{job=\"recyclarr\"}) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Successful syncs (26h)",
      "description": "Daily schedule 05:15 America/Chicago, plus manual syncs. 0 here is what RecyclarrSyncStale alerts on.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(((recyclarr_sync_job_duration_seconds_count{recyclarr_sync_job_status=\"succeeded\"} unless recyclarr_sync_job_duration_seconds_count offset 26h) or increase(recyclarr_sync_job_duration_seconds_count{recyclarr_sync_job_status=\"succeeded\"}[26h]))) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Failed syncs (7d)",
      "description": "Syncs that ended with any status other than succeeded. Recyclarr 9 fails a sync on unknown trash_ids.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(((recyclarr_sync_job_duration_seconds_count{recyclarr_sync_job_status!=\"succeeded\"} unless recyclarr_sync_job_duration_seconds_count offset 7d) or increase(recyclarr_sync_job_duration_seconds_count{recyclarr_sync_job_status!=\"succeeded\"}[7d]))) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Avg sync duration (7d)",
      "description": "Mean duration of syncs in the last 7 days (sum/count of the histogram).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(((recyclarr_sync_job_duration_seconds_sum unless recyclarr_sync_job_duration_seconds_sum offset 7d) or increase(recyclarr_sync_job_duration_seconds_sum[7d]))) / sum(((recyclarr_sync_job_duration_seconds_count unless recyclarr_sync_job_duration_seconds_count offset 7d) or increase(recyclarr_sync_job_duration_seconds_count[7d])))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Manual vs scheduled (7d)",
      "description": "Syncs by trigger: manual (CLI/API) or scheduled.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (recyclarr_sync_job_trigger) (((recyclarr_sync_job_duration_seconds_count unless recyclarr_sync_job_duration_seconds_count offset 7d) or increase(recyclarr_sync_job_duration_seconds_count[7d])))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Syncs per hour by status",
      "description": "Each bar is the number of syncs that finished in that hour. Green: succeeded; red: anything else.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "interval": "1h",
          "legendFormat": "{{recyclarr_sync_job_status}}",
          "expr": "sum by (recyclarr_sync_job_status) (((recyclarr_sync_job_duration_seconds_count unless recyclarr_sync_job_duration_seconds_count offset 1h) or increase(recyclarr_sync_job_duration_seconds_count[1h])))"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "succeeded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Sync duration (mean per hour)",
      "description": "Mean duration of the syncs that finished in each hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "interval": "1h",
          "legendFormat": "duration",
          "expr": "sum(((recyclarr_sync_job_duration_seconds_sum unless recyclarr_sync_job_duration_seconds_sum offset 1h) or increase(recyclarr_sync_job_duration_seconds_sum[1h]))) / sum(((recyclarr_sync_job_duration_seconds_count unless recyclarr_sync_job_duration_seconds_count offset 1h) or increase(recyclarr_sync_job_duration_seconds_count[1h]))) > 0"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "drawStyle": "points",
            "pointSize": 8,
            "lineWidth": 2,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Sonarr/Radarr API latency (p95)",
      "description": "95th percentile of Recyclarr's outgoing HTTP requests (to Sonarr, Radarr and the guide providers), by host.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "legendFormat": "{{server_address}}",
          "expr": "histogram_quantile(0.95, sum by (le, server_address) (rate(http_client_request_duration_seconds_bucket{job=\"recyclarr\"}[1h])))"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "id": 8
    }
  ]
}
