      "panels": [
        {
          "type": "timeseries",
          "id": 11,
          "title": "All sensors on $node",
          "description": "Every raw hwmon temperature on the node. Sentinel values (-127, 0, sub-1°C junk) are filtered out. The MacBook's applesmc exposes about 40 sensors.",
