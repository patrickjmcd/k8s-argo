      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance) (node_hwmon_temp_celsius * on (instance, chip, pod) group_left (chip_name) node_hwmon_chip_names{chip_name=~\"cpu_thermal|coretemp|k10temp\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
