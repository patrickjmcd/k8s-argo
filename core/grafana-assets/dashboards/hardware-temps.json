    {
      "type": "timeseries",
      "id": 9,
      "title": "Fan speed",
      "description": "MacBook fans (applesmc, mbpfan floor ~2000 RPM) and Pi fans (pwmfan / Pi 5 cooling fan). Nodes without a fan sensor don't appear: pi4-kube1 has none.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
