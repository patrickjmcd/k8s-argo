{
  "uid": "adsb-frequent",
  "title": "ADS-B Frequent Aircraft",
  "tags": [
    "adsb"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Unique aircraft",
      "datasource": {
        "type": "postgres",
        "uid": "adsb-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "adsb-postgres"
          },
          "rawSql": "SELECT count(*) FROM aircraft",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Helicopters (cat A7)",
      "datasource": {
        "type": "postgres",
        "uid": "adsb-postgres"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "adsb-postgres"
          },
          "rawSql": "SELECT count(*) FROM aircraft WHERE is_rotorcraft",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Total sightings (passes)",
      "datasource": {
        "type": "postgres",
        "uid": "adsb-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "adsb-postgres"
          },
          "rawSql": "SELECT count(*) FROM sightings",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Most frequently seen",
      "datasource": {
        "type": "postgres",
        "uid": "adsb-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "adsb-postgres"
          },
          "rawSql": "SELECT registration AS \"Reg\", last_flight AS \"Flight\", aircraft_type AS \"Type\", category AS \"Cat\", appearances AS \"Passes\", round(total_seconds/60.0,1) AS \"Min seen\", last_seen AS \"Last seen\" FROM aircraft ORDER BY appearances DESC, last_seen DESC LIMIT 40",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Passes",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Most frequent helicopters",
      "datasource": {
        "type": "postgres",
        "uid": "adsb-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "adsb-postgres"
          },
          "rawSql": "SELECT registration AS \"Reg\", last_flight AS \"Flight\", aircraft_type AS \"Type\", category AS \"Cat\", appearances AS \"Passes\", round(total_seconds/60.0,1) AS \"Min seen\", last_seen AS \"Last seen\" FROM aircraft WHERE is_rotorcraft ORDER BY appearances DESC, last_seen DESC LIMIT 40",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Passes",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Sightings per hour (last 7d)",
      "datasource": {
        "type": "postgres",
        "uid": "adsb-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "adsb-postgres"
          },
          "rawSql": "SELECT date_trunc('hour', started_at) AS time, count(*) AS sightings FROM sightings WHERE started_at > now() - interval '7 days' GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ]
}