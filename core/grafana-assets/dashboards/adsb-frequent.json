{
  "uid": "adsb-frequent",
  "title": "ADS-B Frequent Aircraft",
  "tags": [
    "adsb"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Unique aircraft",
      "datasource": {
        "type": "postgres",
        "uid": "adsb-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "adsb-postgres"
          },
          "rawSql": "SELECT count(*) FROM aircraft",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Repeat visitors (2+ days)",
      "description": "Aircraft seen overhead on two or more distinct local calendar days.",
      "datasource": {
        "type": "postgres",
        "uid": "adsb-postgres"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "adsb-postgres"
          },
          "rawSql": "SELECT count(*) FROM (SELECT hex FROM sightings GROUP BY hex HAVING count(DISTINCT (started_at AT TIME ZONE 'America/New_York')::date) >= 2) t",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Helicopters (cat A7)",
      "datasource": {
        "type": "postgres",
        "uid": "adsb-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "adsb-postgres"
          },
          "rawSql": "SELECT count(*) FROM aircraft WHERE is_rotorcraft",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Busiest day (unique aircraft)",
      "description": "The most distinct aircraft recorded on any single local calendar day.",
      "datasource": {
        "type": "postgres",
        "uid": "adsb-postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "adsb-postgres"
          },
          "rawSql": "SELECT max(c) FROM (SELECT count(DISTINCT hex) c FROM sightings GROUP BY (started_at AT TIME ZONE 'America/New_York')::date) t",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Most days seen",
      "description": "Aircraft ranked by the number of distinct local calendar days they flew overhead — not by ping/pass count.",
      "datasource": {
        "type": "postgres",
        "uid": "adsb-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "adsb-postgres"
          },
          "rawSql": "SELECT a.registration AS \"Reg\", a.last_flight AS \"Flight\", a.aircraft_type AS \"Type\", a.category AS \"Cat\", count(DISTINCT (s.started_at AT TIME ZONE 'America/New_York')::date) AS \"Days seen\", count(*) AS \"Passes\", min(s.started_at) AS \"First seen\", max(s.ended_at) AS \"Last seen\" FROM aircraft a JOIN sightings s USING (hex) GROUP BY a.hex, a.registration, a.last_flight, a.aircraft_type, a.category ORDER BY \"Days seen\" DESC, \"Passes\" DESC LIMIT 40",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Days seen",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Most days seen — helicopters",
      "description": "Rotorcraft (emitter category A7) ranked by distinct local calendar days seen.",
      "datasource": {
        "type": "postgres",
        "uid": "adsb-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "adsb-postgres"
          },
          "rawSql": "SELECT a.registration AS \"Reg\", a.last_flight AS \"Flight\", a.aircraft_type AS \"Type\", count(DISTINCT (s.started_at AT TIME ZONE 'America/New_York')::date) AS \"Days seen\", count(*) AS \"Passes\", min(s.started_at) AS \"First seen\", max(s.ended_at) AS \"Last seen\" FROM aircraft a JOIN sightings s USING (hex) WHERE a.is_rotorcraft GROUP BY a.hex, a.registration, a.last_flight, a.aircraft_type ORDER BY \"Days seen\" DESC, \"Passes\" DESC LIMIT 40",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Days seen",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Unique aircraft per day (last 30d)",
      "datasource": {
        "type": "postgres",
        "uid": "adsb-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "adsb-postgres"
          },
          "rawSql": "SELECT (date_trunc('day', started_at AT TIME ZONE 'America/New_York') AT TIME ZONE 'America/New_York') AS time, count(DISTINCT hex) AS \"unique aircraft\" FROM sightings WHERE started_at > now() - interval '30 days' GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ]
}
