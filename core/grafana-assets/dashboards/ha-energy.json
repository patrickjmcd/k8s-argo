          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT s.ts AS \"time\", e.label AS metric, s.value AS value\nFROM ha_series(ARRAY['sensor.vue_gen_3_left_side_power_minute_average', 'sensor.vue_gen_3_right_side_power_minute_average'], $__timeFrom(), $__timeTo(), make_interval(secs => $__interval_ms / 1000.0)) s\nJOIN ha_entities e USING (entity_id)\nORDER BY 1"
