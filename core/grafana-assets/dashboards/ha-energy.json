          "format": "time_series",
          "rawSql": "SELECT s.ts AS \"time\", e.label AS metric, s.value AS value\nFROM ha_series(ARRAY(SELECT e.entity_id FROM ha_entities e WHERE e.domain = 'sensor' AND e.device_class = 'power' AND e.entity_id !~ '(minute_average|instantaneous_demand|tripplite)'), $__timeFrom(), $__timeTo(), make_interval(secs => $__interval_ms / 1000.0)) s\nJOIN ha_entities e USING (entity_id)\nORDER BY 1"
