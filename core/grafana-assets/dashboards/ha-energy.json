          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT e.label AS \"Circuit\", ha_num(e.state) AS \"Power\"\nFROM ha_entities e\nWHERE (e.entity_id ~ '_power_minute_average' AND e.entity_id !~ '^sensor\\.vue_gen_3_(left|right)_side_power_minute_average$') AND ha_num(e.state) > 0\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
