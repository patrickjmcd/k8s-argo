          "format": "time_series",
          "rawSql": "SELECT time_bucket(make_interval(secs => $__interval_ms / 1000.0), time) AS \"time\", count(*) AS \"rows\"\nFROM ltss WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1"
