        "type": "postgres",
        "uid": "ha-timescale"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ha-timescale"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT extract(epoch FROM now() - max(time)) FROM ltss"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
