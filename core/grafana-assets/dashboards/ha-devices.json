    {
      "type": "table",
      "title": "Top writers (24h)",
      "description": "Entities writing the most rows: candidates to exclude from LTSS.",
      "datasource": {
        "type": "postgres",
        "uid": "ha-timescale"
      },
      "targets": [
        {
          "datasource": {
