          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT e.label AS \"Entity\", l.entity_id AS \"ID\", count(*) AS \"Rows\"\nFROM ltss l JOIN ha_entities e USING (entity_id)\nWHERE l.time > now() - INTERVAL '24 hours'\nGROUP BY 1, 2 ORDER BY 3 DESC LIMIT 20"
        }
