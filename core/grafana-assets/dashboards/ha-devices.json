          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT e.label AS \"Device\", ha_num(e.state) AS \"Battery\", e.last_seen AS \"Reported\"\nFROM ha_entities e WHERE e.domain = 'sensor' AND e.device_class = 'battery' AND e.unit = '%' AND ha_num(e.state) IS NOT NULL ORDER BY 2"
