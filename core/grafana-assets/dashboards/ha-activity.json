          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT s.ts AS \"time\", e.label AS metric,\n  CASE s.state WHEN 'on' THEN 1 WHEN 'off' THEN 0 ELSE -1 END AS value\nFROM ha_states(ARRAY[${openings:sqlstring}]::text[], $__timeFrom(), $__timeTo()) s\nJOIN ha_entities e USING (entity_id)\nORDER BY 1"
        }
