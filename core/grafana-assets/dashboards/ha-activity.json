    {
      "type": "table",
      "title": "Last activity",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "ha-timescale"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ha-timescale"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT e.label AS \"Sensor\", max(l.time) FILTER (WHERE l.state = 'on') AS \"Last active\",\n  count(*) FILTER (WHERE l.state = 'on') AS \"Activations\"\nFROM ltss l JOIN ha_entities e USING (entity_id)\nWHERE (l.entity_id IN (${motion:sqlstring}) OR l.entity_id IN (${openings:sqlstring}))\n  AND $__timeFilter(l.time)\nGROUP BY 1 ORDER BY 2 DESC NULLS LAST"
        }
      ],
