          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT time_bucket(make_interval(secs => $__interval_ms / 1000.0), l.time) AS \"time\", e.label AS metric, count(*) AS value\nFROM ltss l JOIN ha_entities e USING (entity_id)\nWHERE l.entity_id IN (${motion:sqlstring}) AND l.state = 'on' AND $__timeFilter(l.time)\nGROUP BY 1, 2 ORDER BY 1"
        }
