          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "adsb_aircraft_by_type > 0",
          "refId": "A",
          "legendFormat": "{{type}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value"
          ]
        }
      },
