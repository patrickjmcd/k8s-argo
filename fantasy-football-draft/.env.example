# Copy to .env and fill in. Both servers read from this file.
# Keep .env out of git (it's in .gitignore) — it holds tokens and cookies.

# ---------------------------------------------------------------------------
# Yahoo  (official OAuth2 API)
# ---------------------------------------------------------------------------
# Register an app at https://developer.yahoo.com/apps/ (Fantasy Sports, Read)
# to get the consumer key/secret. Then run:  python -m mcp_yahoo.auth
YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=
YAHOO_LEAGUE_ID=            # the numeric league id from your league URL
YAHOO_GAME_CODE=nfl
# YAHOO_GAME_ID=449         # optional: pin a specific season's game id
YAHOO_TEAM_ID=             # your numeric team id within the league
YAHOO_DRAFT_SLOT=          # optional: your 1-based draft position (for "picks until my turn")
# YAHOO_ACCESS_TOKEN_JSON is written automatically by `python -m mcp_yahoo.auth`

# ---------------------------------------------------------------------------
# ESPN  (unofficial API — cookies from a logged-in browser session)
# ---------------------------------------------------------------------------
# For a PRIVATE league, log into espn.com, open dev tools > Application >
# Cookies, and copy the values of espn_s2 and SWID. Public leagues need neither.
ESPN_LEAGUE_ID=
ESPN_SEASON=2026
ESPN_S2=
ESPN_SWID=                 # include the surrounding braces, e.g. {ABC-123-...}
ESPN_TEAM_ID=              # your numeric team id within the league
ESPN_DRAFT_SLOT=           # optional: your 1-based draft position (snake)
ESPN_AUCTION_BUDGET=200    # per-team budget if your league is an auction draft
